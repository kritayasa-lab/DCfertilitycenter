# Copy to .env.local for local development. Never commit real values.
# Variable NAMES only are documented here; values are configured per
# environment (Development / Preview / Production) in Vercel.

# --- Phase 1 (optional) -------------------------------------------------
# Public base URL used for canonical/hreflang/Open Graph URLs.
# Falls back to https://$VERCEL_URL on Vercel, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Set to "true" ONLY for the approved production launch. Anything else keeps
# the site out of search engines (robots noindex + robots.txt disallow).
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Phase 3+ (not yet used; listed for planning) ----------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never NEXT_PUBLIC_*
# RATE_LIMIT_SALT=                  # server-only

# --- Inquiry delivery (prepared, NOT connected) -------------------------
# Google Apps Script web-app URL (must be https://script.google.com/...).
# Delivery also requires INQUIRY_DELIVERY_ENABLED=true, which must not be set
# until the Phase 6 review (anti-spam, privacy notice, retention) is approved.
# GOOGLE_APPS_SCRIPT_URL=          # server-only
# INQUIRY_DELIVERY_ENABLED=        # server-only, "true" to enable

# --- Deferred until approved (Phase 6+) ---------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=             # server-only
# RESEND_API_KEY=                   # server-only
# INQUIRY_NOTIFY_EMAIL=             # server-only
